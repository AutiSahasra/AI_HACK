# Application
PROJECT_NAME="AI Root Cause Analysis & Intelligent Ticket Resolution Copilot"
ENVIRONMENT=development
API_V1_STR=/api

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_rca_copilot
USE_IN_MEMORY_DB=false

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-with-cryptographic-random-in-prod-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ingestion Settings
MAX_UPLOAD_SIZE_BYTES=20971520

# AI RCA Model Configuration
LLM_PROVIDER=mock
# For OpenAI / OpenAI-compatible (Ollama/vLLM/LocalAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# For Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Live Demo App
DEMO_APP_URL=http://localhost:8001
DEMO_APP_HOST=localhost
DEMO_APP_PORT=8001

# Collector
COLLECTOR_API_KEY=collector-secret-api-key-live-demo-2026
COLLECTOR_BATCH_SIZE=20
COLLECTOR_FLUSH_INTERVAL_SECS=3
